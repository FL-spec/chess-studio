{
  "manifest_version": 3,
  "name": "Chess Studio",
  "version": "1.8.1",
  "description": "Free, offline chess practice and game review.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "action": {
    "default_title": "Chess Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://lichess.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "read-fen.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "detect-entry.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "detect.mjs",
        "vendor/chess.mjs",
        "board-mark.mjs"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*"
      ]
    }
  ]
}
